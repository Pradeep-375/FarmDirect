# Copy to .env and fill in. NEVER commit .env.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=farmdirect
MYSQL_USER=farmdirect
MYSQL_PASSWORD=change-me-db

# >= 32 random characters (e.g. `openssl rand -base64 48`)
JWT_SECRET=

# Bootstrap administrator (created on first start when all three are set)
ADMIN_EMAIL=
ADMIN_MOBILE=
ADMIN_PASSWORD=

# Email notifications. docker compose ships MailHog (http://localhost:8025) for local development.
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_FROM=no-reply@farmdirect.example

# SMS notifications: msg91 or twilio (real provider credentials required; nothing is simulated)
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_NOTIFY_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Razorpay (use test-mode keys first)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

FRONTEND_URL=http://localhost:3000
FRONTEND_PORT=3000
# Set true ONLY for local development to create sample farmers/products
SEED_SAMPLE_DATA=false
