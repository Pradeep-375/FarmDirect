# Frontend (Vite). Leave blank when the app is served behind the nginx proxy (Docker / Kubernetes).
# For Vercel, set these to your public backend URL.
VITE_API_URL=
VITE_WS_URL=
# Optional routing service for drawing a route line on tracking maps (e.g. your own OSRM server). Without it only markers are shown.
VITE_OSRM_URL=
